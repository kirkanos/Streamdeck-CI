{
  "name": "streamdeck-ci",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CI Glance: Woodpecker CI and GitHub Actions pipeline status on the Stream Deck.",
  "streamdeck": {
    "id": "com.kirkanos.ci",
    "name": "CI Glance"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "watch:dev": "node scripts/build.mjs --dev --watch",
    "link:dev": "node scripts/build.mjs --dev && streamdeck link dist/com.kirkanos.ci-dev.sdPlugin",
    "restart:dev": "streamdeck restart com.kirkanos.ci-dev",
    "validate": "node scripts/build.mjs && streamdeck validate dist/com.kirkanos.ci.sdPlugin",
    "pack": "node scripts/build.mjs && streamdeck pack dist/com.kirkanos.ci.sdPlugin --output Release --force",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.5.1"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.1"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.1",
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/node20": "^20.1.6",
    "@types/node": "^24.1.0",
    "rollup": "^4.63.5",
    "tslib": "^2.8.1",
    "typescript": "^6.0.0",
    "vitest": "^5.0.2"
  }
}
